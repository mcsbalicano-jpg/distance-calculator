   # Ask for distance in km
  kilometers = float(input("Enter distance in kilometers: ")) 
  miles = 0.621371
  
  #Compute distance
  distance = kilometers * miles
  print("Distance in miles:",distance)
  
  # Ask if you want the program to repeat
  question = input("Do you want to convert another distance? (yes/no): ")
  
  # repeat if confirmed
  if question == "yes":
      kilometers = float(input("Enter distance in kilometers: "))
      distance = kilometers * miles
      print("Distance in miles:",distance)
  
  # End  program
  else:
      print("Program ended.")

